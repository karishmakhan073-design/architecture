import os
from dotenv import load_dotenv
from groq import Groq

# Load variables from .env
load_dotenv()

# Get Groq API key
api_key = os.getenv("GROQ_API_KEY")

# Check whether API key exists
if not api_key:
    raise ValueError(
        "GROQ_API_KEY not found. Please add your Groq API key to the .env file."
    )

# Create Groq client
client = Groq(api_key=api_key)

# Send a test request to Groq
try:
    response = client.chat.completions.create(
        model="llama-3.3-70b-versatile",
        messages=[
            {
                "role": "user",
                "content": "Hello! Give me a short introduction to RK Health."
            }
        ],
        temperature=0.8,
        max_tokens=2048
    )

    # Display the AI response
    print("\nGroq AI Response:")
    print(response.choices[0].message.content)

except Exception as e:
    print("\nError while communicating with Groq:")
    print(e)